# ============================================================
# PAKAL Mission Control — configuración local
# Copia este archivo a .env y llénalo. .env NUNCA se sube a git.
# ============================================================

# ---------- Servidor ----------
HOST=127.0.0.1
PORT=8080
# URL que aparece en los correos; por defecto http://localhost:<PORT>
# PUBLIC_URL=http://localhost:8080
# true solo si lo pones detrás de nginx/cloudflared
TRUST_PROXY=false

# ---------- Firebase (solo se usan con PAKAL_PRODUCCION=true) ----------
# Cuenta de servicio: Firebase → Configuración → Cuentas de servicio → Generar clave.
# Guárdala en secrets/ (ya está en .gitignore). ES UNA CREDENCIAL REAL: acceso total.
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json

# Configuración web (pública por diseño): Firebase → Configuración → Tus apps → SDK config
FIREBASE_WEB_API_KEY=AIzaSyB7DeDh678alLOmIhnw_ftM3YFir25i848
FIREBASE_WEB_AUTH_DOMAIN=exploreupcontrol.firebaseapp.com
FIREBASE_PROJECT_ID=exploreupcontrol
FIREBASE_WEB_STORAGE_BUCKET=exploreupcontrol.firebasestorage.app
FIREBASE_WEB_SENDER_ID=622863959029
FIREBASE_WEB_APP_ID=1:622863959029:web:4673f0d6e6be38b2cfd6bc

# ⚠ Por defecto TODO es local: Firebase en emuladores, nada toca producción.
PAKAL_DEMO=true
# Solo si algún día quieres conectar al Firebase real (y PAKAL_DEMO=false):
PAKAL_PRODUCCION=false

# ---------- Google Drive → análisis IA ----------
# Apagado: vigilar Drive real es salir de lo local. Usa la subida desde la app o `npm run analizar`.
DRIVE_WATCH=false
# campus:equipo:folderId separados por coma. Comparte cada carpeta (Lector) con el
# client_email de la cuenta de servicio, o no podrá verlas.
DRIVE_CARPETAS=Mixcoac:Telecomunicaciones:1KQGeEaQ7SW6kmWfgUdt4HZteyOwkOltx,Mixcoac:Control:1zCVAajjlZ3BLmskyQUjuXxSkY7AUs6Do,Mixcoac:Operaciones:1K1ToaZ3pDK-QLPp8l4OQcxXzUKo7kpE9
DRIVE_INTERVALO_SEG=120
# false = solo lo que se suba desde que arrancas el servidor
DRIVE_ANALIZAR_EXISTENTES=false
# Reportes y ensayos (sin código) se mandan a la revisión de documentos
DRIVE_REVISAR_DOCUMENTOS=true
# Otra cuenta de servicio solo para Drive (opcional; por defecto la de Firebase)
# DRIVE_SERVICE_ACCOUNT_PATH=secrets/drive-service-account.json

# ---------- IA (en la nube: no usa tu GPU) ----------
# Orden de proveedores. El heurístico (sin IA) siempre queda al final como respaldo.
IA_PROVEEDORES=gemini,heuristico
# Key gratis en https://aistudio.google.com/apikey (funciona con tu cuenta @up.edu.mx o personal)
GEMINI_API_KEY=
# Si el primero se queda sin cuota (429), usa el siguiente
GEMINI_MODELOS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-flash-latest

# Opcionales (agrégalos a IA_PROVEEDORES si los quieres)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ---------- Correo ----------
# Se intentan en este orden; si todos fallan, el correo queda en data/outbox y se reintenta solo.
MAIL_TRANSPORTES=gmail,resend,smtp
MAIL_FROM=PAKAL Mission Control <no-reply@exploreup.mx>

# Gmail: https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Resend: con onboarding@resend.dev solo llega a tu correo de registro
RESEND_API_KEY=

# SMTP genérico (Outlook/Office365: smtp.office365.com:587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

MAIL_REINTENTO_SEG=300
MAIL_MAX_INTENTOS=50
# true = no envía, guarda .eml en data/outbox (para ensayar)
MAIL_DRY_RUN=false

# ---------- A quién llegan los análisis ----------
# Siempre reciben copia (coma separada). En demo SOLO estos reciben correo:
ANALISIS_DESTINATARIOS=
# Además, los miembros del área dueña de la carpeta y quien subió el archivo:
ANALISIS_NOTIFICAR_EQUIPO=true
ANALISIS_NOTIFICAR_AUTOR=true

# ---------- Recordatorios de tareas ----------
RECORDATORIOS=true
RECORDATORIOS_HORA=8
RECORDATORIOS_DIAS=7,3,1

# ---------- Retención de datos ----------
# Días que se guarda la bitácora de accesos (IP, navegador) y las copias locales de reportes
RETENCION_BITACORA_DIAS=90
RETENCION_COPIAS_DIAS=365

# ---------- Bloqueo por intentos de abrir el código ----------
BLOQUEO_INTENTOS=3
BLOQUEO_VENTANA_MIN=10
BLOQUEO_DURACION_MIN=5

LOG_LEVEL=info
